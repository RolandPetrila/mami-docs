# Mami_Docs — environment variables template
# Copy to .env.local pentru dev local. NU commit-ui valori reale!
# .env.local e în .gitignore.
#
# Pentru production (Cloudflare Pages), aceste variabile se setează în:
#   Cloudflare Dashboard → Pages → mami-docs → Settings → Environment Variables
#
# Pentru workers (Cloudflare), folosește secrets (NU env vars Pages):
#   wrangler secret put GROQ_API_KEY -c workers/ai-gateway/wrangler.toml
#   wrangler secret put SUPABASE_URL -c workers/keepalive/wrangler.toml
#   wrangler secret put SUPABASE_ANON_KEY -c workers/keepalive/wrangler.toml

# === Frontend (Vite, prefix VITE_ obligatoriu pentru ca să fie expus în browser) ===

# AI Gateway URL (worker public, NU e secret)
VITE_AI_GATEWAY_URL=https://mami-docs-ai.petrilarolly.workers.dev

# Supabase (anon key e public-safe — RLS protejează)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Notificări push (topic ntfy.sh, semi-public — vezi docs/CREDENTIALS_NEEDED.md §2)
VITE_NTFY_URL=

# CallMeBot WhatsApp (Faza 2, opțional — vezi §3)
# T6.2 — REMOVED: CALLMEBOT key e acum în keepalive worker (POST /notify).
# Setează doar `VITE_KEEPALIVE_URL` mai jos.
# Vezi VITE_KEEPALIVE_URL.

# Firebase Cloud Messaging (Faza 2, opțional — vezi §4)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# T6.2 — Worker keepalive endpoint (server-side CallMeBot proxy, POST /notify)
VITE_KEEPALIVE_URL=https://mami-docs-keepalive.petrilarolly.workers.dev
